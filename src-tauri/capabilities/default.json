{
  "identifier": "default",
  "description": "Default capabilities for SecurePass",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "core:window:allow-close",
    "core:window:allow-set-size",
    "core:window:allow-set-fullscreen",
    {
      "identifier": "fs:scope",
      "allow": {
        "path": "$APPDATA/**"
      }
    }
  ]
}
